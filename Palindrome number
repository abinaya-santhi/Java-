class Solution {
    public boolean isPalindrome(int n) {
        // code here
        boolean result = false;
        if ( n < 0){
            result = false;
        }
        int temp = n;
        int rev = 0;
        
        while(temp != 0){
            int digit = temp % 10;
            rev = rev * 10 + digit;
            temp = temp / 10;
        }
        if ( n == rev){
            result = true;
        }
        return result;
        
    }
}
