class Solution {
    public ArrayList<Integer> getMinMax(int[] arr) {
        ArrayList <Integer> list = new ArrayList<>();
        
        int max = arr[0];
        int min = arr[0];
        for (int l = 0; l < arr.length ; l++){
            if ( arr[l] > max){
                max = arr[l];
            }
            if (arr[l] < min){
                min = arr[l];
            }
        }
        list.add(min);
        list.add(max);
        return list;
            
        
        
    }
}
