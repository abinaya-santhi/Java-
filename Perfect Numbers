class Solution {
    static boolean isPerfect(int n) {
        // code here
        boolean result = false;
        ArrayList<Integer> list = new ArrayList<>();
        for (int i = 1; i*i <= n; i++){
            if ( n % i == 0){
                list.add(i);
                if (i != n/ i){
                    list.add(n/i);
                }
            }
        }
        Collections.sort(list);
        int sum = 0;
        for (int i = 0; i < list.size() - 1; i++){
            
            sum = sum + list.get(i);
        }
        if (sum == n){
            result = true;
        }
        return result;
    }
}
