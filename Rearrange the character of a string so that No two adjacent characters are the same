public class Main
{
	public static void main(String[] args) {
		
		
		java.util.Scanner sc = new java.util.Scanner(System.in);
        String s = sc.nextLine();

        int n = s.length();
        int[] freq = new int[26];

// count frequency
        for(int i = 0; i < n; i++) {
            freq[s.charAt(i) - 'a']++;
        }

// find max frequency character
        int max = 0;
        for(int i = 1; i < 26; i++) {
            if(freq[i] > freq[max]) {
                max = i;
            }
        }

// check impossible condition
        if(freq[max] > (n + 1) / 2) {
            System.out.println("Impossible");
            return;
        }

        char[] result = new char[n];
        int index = 0;
    
// place most frequent character first
        while(freq[max] > 0) {
            result[index] = (char)(max + 'a');
            index += 2;
            freq[max]--;
        }

// place remaining characters
        for(int i = 0; i < 26; i++) {
            while(freq[i] > 0) {

                if(index >= n) {
                    index = 1;
                }

                result[index] = (char)(i + 'a');
                index += 2;
                freq[i]--;
            }
        }

        System.out.println(new String(result));
	}
}
